# ==== Twilio (https://console.twilio.com) — OPTIONAL, leave blank for now ====
# Without these three set, the server runs in NO-SMS MODE: anyone can log
# in with any phone number instantly, no code needed. Good for testing
# chat/calls with people you trust. Fill these in later, whenever you're
# ready for real SMS verification — no code changes needed, it switches
# on automatically.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# ==== Auth tokens issued by THIS backend to logged-in users ====
# Generate a strong random string, e.g.: openssl rand -hex 32
JWT_SECRET=change_this_to_a_long_random_string

# ==== Server ====
PORT=3000

# Comma-separated list of origins allowed to call this API.
# During local testing with the HTML file opened directly, use "*".
# In production, set this to your real frontend domain(s).
CORS_ORIGIN=*

# ==== Firebase Cloud Messaging (push notifications) — optional ====
# Without these, chat still works fully in real time while the app is
# open; you just won't get a notification while it's fully closed.
# Get them from: Firebase Console -> Project Settings -> Service Accounts
# -> Generate new private key (downloads a JSON file) -> copy 3 fields:
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nXXXXXXXX\n-----END PRIVATE KEY-----\n"
